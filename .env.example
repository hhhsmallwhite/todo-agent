# 复制本文件为 .env 再填值。.env 已在 .gitignore 里，不会被提交。
# 注意：这里只有占位符，永远不要把真实 Key 写进仓库。

# 模型提供方给你的 Key（必填，否则只能跑 --mock / scripts/demo_offline.py）
API_KEY=

# OpenAI 兼容服务地址（可选）。
# 留空 = 官方 https://api.openai.com/v1
# 硅基流动示例：https://api.siliconflow.cn/v1
# DeepSeek 示例：https://api.deepseek.com/v1
BASE_URL=

# 模型名。要和你用的 BASE_URL 提供的模型名一致（不同平台名字不一样）。
MODEL=gpt-4o-mini

# SQLite 文件路径。相对路径按"项目根目录"解析，不按当前工作目录。
DB_PATH=todos.db

# 单次对话最多几轮模型调用（兜底，防止模型陷入"调工具-报错-再调"的死循环）。
MAX_TURNS=8
